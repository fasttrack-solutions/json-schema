{
  "$id": "https://www.fasttrack-solutions.com/en/resources/integration/real-time-data/login-v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Login Event (LOGIN)",
  "type": "object",
  "properties": {
    "user_id": {
      "description": "The unique id of the user",
      "type": "string",
      "minLength": 1
    },
    "is_impersonated": {
      "description": "This field is true when the login event was triggered by an admin impersonating a user",
      "type": "boolean"
    },
    "ip_address": {
      "description": "The IP address in dotted decimal or IPv6 form",
      "type": "string"
    },
    "user_agent": {
      "description": "The user agent of the user",
      "type": "string"
    },
    "timestamp": {
      "description": "Timestamp in RFC3339 format",
      "type": "string",
      "format": "date-time"
    },
    "origin": {
      "description": "The Origin of the user",
      "type": "string"
    },
    "skip_publishing": {
      "description": "Flag to skip publishing",
      "type": "boolean"
    }
  },
  "required": [
    "user_id",
    "timestamp",
    "origin"
  ]
}
