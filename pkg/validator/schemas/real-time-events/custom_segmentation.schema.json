{
  "$id": "https://www.fasttrack-solutions.com/en/resources/integration/real-time-data/custom-segmentation",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Custom Segmentation Event (CUSTOM_SEGMENTATION)",
  "type": "object",
  "properties": {
    "user_id": {
      "description": "The unique id of the user",
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "description": "The Origin of the user",
      "type": "string"
    },
    "source": {
      "description": "Is used to determine what import type is used",
      "type": "string"
    },
    "timestamp": {
      "description": "Timestamp in RFC3339 format",
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "description": "List of custom fields as key value pairs",
      "type": "object"
    },
    "skip_publishing": {
      "description": "Flag to skip publishing",
      "type": "boolean"
    }
  },
  "required": [
    "user_id",
    "origin",
    "source",
    "timestamp",
    "data"
  ]
}
