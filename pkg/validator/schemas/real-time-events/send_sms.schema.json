{
  "$id": "https://www.fasttrack-solutions.com/en/resources/integration/real-time-data/send-sms",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Send SMS Event (SEND_SMS)",
  "type": "object",
  "properties": {
    "user_id": {
      "description": "The unique id of the user",
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "description": "Timestamp in RFC3339 format",
      "type": "string",
      "format": "date-time"
    },
    "origin": {
      "description": "The origin of the event",
      "type": "string"
    },
    "content": {
      "description": "Text message content",
      "type": "string"
    },
    "remove_stop_text": {
      "description": "Remove unsubscribe text",
      "type": "boolean"
    }
  },
  "required": [
    "user_id",
    "timestamp",
    "origin",
    "content"
  ]
}
