{
  "$id": "https://www.fasttrack-solutions.com/en/resources/integration/real-time-data/casumo-valuable",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Casumo Valuable Event (CASUMO_VALUABLE)",
  "type": "object",
  "properties": {
    "user_id": {
      "description": "The unique id of the user",
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "description": "Timestamp in RFC3339 format",
      "type": "string",
      "format": "date-time"
    },
    "origin": {
      "description": "The Origin of the user",
      "type": "string"
    },
    "slug": {
      "description": "The slug of the valuable",
      "type": "string"
    },
    "title": {
      "description": "The title of the valuable",
      "type": "string"
    },
    "description": {
      "description": "The description of the valuable",
      "type": "string"
    },
    "status": {
      "description": "The status of the valuable, e.g. Fresh, Used, Expired",
      "type": "string"
    },
    "expires": {
      "description": "Expiry timestamp in RFC3339 format",
      "type": "string"
    },
    "reference": {
      "description": "The reference of the valuable, e.g. a trigger hash",
      "type": "string"
    },
    "skip_publishing": {
      "description": "Flag to skip publishing",
      "type": "boolean"
    }
  },
  "required": [
    "user_id",
    "timestamp",
    "origin",
    "slug",
    "title",
    "description",
    "status"
  ]
}
