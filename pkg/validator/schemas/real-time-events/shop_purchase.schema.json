{
  "$id": "https://www.fasttrack-solutions.com/en/resources/integration/real-time-data/shop-purchase",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shop Purchase Event (SHOP_PURCHASE)",
  "type": "object",
  "properties": {
    "user_id": {
      "description": "The unique id of the user",
      "type": "string",
      "minLength": 1
    },
    "transaction_id": {
      "description": "The transaction ID of the purchase",
      "type": "string"
    },
    "type": {
      "description": "The type of the purchase",
      "type": "string"
    },
    "currency": {
      "description": "The currency of the purchase in ISO 4217 format",
      "type": "string"
    },
    "exchange_rate": {
      "description": "The exchange rate used at the timestamp",
      "type": "number"
    },
    "amount": {
      "description": "The amount of the purchase",
      "type": "number"
    },
    "product_id": {
      "description": "The ID of the purchased product",
      "type": "string"
    },
    "is_virtual_product": {
      "description": "Flag whether the product is virtual",
      "type": "boolean"
    },
    "product_sku": {
      "description": "The SKU of the purchased product",
      "type": "string"
    },
    "status": {
      "description": "The status of the purchase",
      "type": "string"
    },
    "bonus_code": {
      "description": "The bonus code applied to the purchase",
      "type": "string"
    },
    "delivery_address": {
      "description": "The delivery address for the purchase",
      "type": "string"
    },
    "timestamp": {
      "description": "Timestamp in RFC3339 format",
      "type": "string",
      "format": "date-time"
    },
    "origin": {
      "description": "The Origin of the user",
      "type": "string"
    },
    "skip_publishing": {
      "description": "Flag to skip publishing",
      "type": "boolean"
    }
  },
  "required": [
    "user_id",
    "transaction_id",
    "type",
    "currency",
    "exchange_rate",
    "amount",
    "product_id",
    "status",
    "timestamp",
    "origin"
  ]
}
