{
  "$id": "https://www.fasttrack-solutions.com/en/resources/integration/real-time-data/wallet-update",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wallet Update Event (WALLET_UPDATE)",
  "type": "object",
  "properties": {
    "user_id": {
      "description": "The unique id of the user",
      "type": "string",
      "minLength": 1
    },
    "balance": {
      "description": "The balance of the wallet",
      "type": "number"
    },
    "currency": {
      "description": "The currency of the wallet in ISO 4217 format",
      "type": "string"
    },
    "exchange_rate": {
      "description": "The exchange rate used at the timestamp",
      "type": "number"
    },
    "timestamp": {
      "description": "Timestamp in RFC3339 format",
      "type": "string",
      "format": "date-time"
    },
    "origin": {
      "description": "The Origin of the user",
      "type": "string"
    },
    "skip_publishing": {
      "description": "Flag to skip publishing",
      "type": "boolean"
    }
  },
  "required": [
    "user_id",
    "currency",
    "exchange_rate",
    "timestamp",
    "origin"
  ]
}
